# MLflow tracking. `local` requires neither Kaggle nor Databricks.
MLFLOW_TRACKING_MODE=local
# Optional: defaults to <project-root>/mlruns when unset.
# MLFLOW_LOCAL_DIR=mlruns

# Databricks remote tracking. Uncomment only for Kaggle or remote runs; 
# do not add real token values to Git.
# DATABRICKS_HOST=https://<your-workspace>.cloud.databricks.com
# DATABRICKS_TOKEN=<databricks-access-token>
# MLFLOW_TRACKING_URI=databricks
# MLFLOW_EXPERIMENT_ID=<mlflow-experiment-id>
