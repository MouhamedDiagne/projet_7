# MLflow tracking. `local` requires neither Kaggle nor Databricks.
MLFLOW_TRACKING_MODE=local
# Seed unique du projet, appliquée à Python, NumPy, TensorFlow et PyTorch.
PROJECT_SEED=42
# Optional: defaults to <project-root>/mlruns when unset.
# MLFLOW_LOCAL_DIR=mlruns
# Optional local path to glove.twitter.27B.50d.txt. Kaggle uses an attached dataset instead.
# GLOVE_EMBEDDING_PATH=data/glove.twitter.27B.50d.txt

# Databricks remote tracking. Uncomment only for Kaggle or remote runs; 
# do not add real token values to Git.
# DATABRICKS_HOST=https://<your-workspace>.cloud.databricks.com
# DATABRICKS_TOKEN=<databricks-access-token>
# MLFLOW_TRACKING_URI=databricks
# MLFLOW_EXPERIMENT_ID=<mlflow-experiment-id>

# Prediction API. The selected mode is loaded once at startup from MLflow.
API_MODEL_MODE=light
API_SQLITE_PATH=api/data/sentiment_api.sqlite3
LIGHT_MODEL_RUN_NAME=tfidf-logreg-benchmark
ADVANCED_MODEL_RUN_NAME=distilbert-frozen-classifier-benchmark
# Pin an immutable release after identifying it in Databricks. If omitted, the
# API uses the latest finished parent run matching the configured name.
# LIGHT_MODEL_RUN_ID=<mlflow-run-id>
# ADVANCED_MODEL_RUN_ID=<mlflow-run-id>
MODEL_ARTIFACT_PATH=selected_model
